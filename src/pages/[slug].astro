---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '../assets/img/logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/video-titles/**/*.{jpg,png,webp}',
  { eager: true }
);

export async function getStaticPaths() {
  const films = await getCollection('films');
  return films.map((film) => ({
    params: { slug: film.id },
    props: { film: film.data },
  }));
}

interface Props {
  film: {
    title: string;
    vimeoId: string | null;
    youtubeId?: string;
    vimeoId2?: string;
    description: string;
    imageCount: number;
    imagePath: string | null;
    imageExtension?: string;
  };
}

const { film } = Astro.props;
const ext = film.imageExtension || '.jpg';
const images: ImageMetadata[] = [];
if (film.imagePath && film.imageCount > 0) {
  const assetBase = film.imagePath.replace('/img/', '/src/assets/img/');
  for (let i = 1; i <= film.imageCount; i++) {
    const key = `${assetBase}${i}${ext}`;
    const img = allImages[key];
    if (img) {
      images.push(img.default);
    }
  }
}
---

<BaseLayout title={film.title}>
  <style is:global>
    #film {
      padding: 24px 0px 0px 20px;
      z-index: 10;
    }
    #photo {
      padding: 24px 20px 0px 0;
      z-index: 10;
      right: 0;
    }
  </style>

  <a class="logo-icon" href="/" transition:name="logo"><Image src={logo} alt="Nima Nabili Rad" /></a>
  <a id="film" class="menuall" href="/film">Film</a>
  <a id="photo" class="menuall" href="/photo">Photo</a>
  <div class="w-full px-4">
    <div class="flex flex-wrap text-center">
      <div class="w-full videobar">
        {film.vimeoId ? (
          <iframe src={`https://player.vimeo.com/video/${film.vimeoId}`} frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        ) : film.youtubeId ? (
          <iframe src={`https://www.youtube.com/embed/${film.youtubeId}`} frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        ) : null}
      </div>

      {film.vimeoId2 && (
        <div class="w-full videobar">
          <iframe src={`https://player.vimeo.com/video/${film.vimeoId2}`} frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      )}

      <div class="w-full videotext">
        <h2>{film.title.replace(' - NIMA NABILI RAD', '')}</h2>
        {film.description && <p set:html={film.description} />}
      </div>

      {images.length > 0 && (
        <div class="w-full imgspace">
          {images.map((src, i) => (
            <Image src={src} alt={`${film.title} - image ${i + 1}`} loading="lazy" />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
