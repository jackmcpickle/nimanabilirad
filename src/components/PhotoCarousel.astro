---
interface Props {
  leftImages: string[];
  rightImages: string[];
  mobileImages: string[];
  breakpoint?: number;
  slickOptions?: Record<string, unknown>;
  includeJsActions?: boolean;
}

const { leftImages, rightImages, mobileImages, breakpoint = 1024, slickOptions, includeJsActions = true } = Astro.props;
---

<div id="left" class="w-full md:w-1/2 no-padd">
  <div class="slider">
    {leftImages.map((src) => (
      <div><img src={src}></div>
    ))}
  </div>
</div>
<div id="right" class="w-full md:w-1/2 no-padd">
  <div class="slider">
    {rightImages.map((src) => (
      <div><img src={src}></div>
    ))}
  </div>
</div>
<div id="mobile" class="w-full no-padd">
  <div class="mslider">
    {mobileImages.map((src) => (
      <div><img src={src}></div>
    ))}
  </div>
</div>

<div id="carousel-config" data-breakpoint={breakpoint} data-slick-options={JSON.stringify(slickOptions || {})} data-include-js-actions={includeJsActions}></div>

<script>
  import $ from 'jquery';

  // Ensure jQuery is global before slick loads (slick extends $.fn)
  window.jQuery = $;
  window.$ = $;
  await import('slick-carousel');

  const configEl = document.getElementById('carousel-config')!;
  const breakpoint = Number(configEl.dataset.breakpoint);
  const slickOptions = JSON.parse(configEl.dataset.slickOptions || '{}');
  const includeJsActions = configEl.dataset.includeJsActions === 'true';

  function safeSlick(selector: string, method: string) {
    const $el = $(selector);
    if ($el.hasClass('slick-initialized')) {
      ($el as any).slick(method);
    }
  }

  const opts = Object.assign({
    dots: false,
    vertical: true,
    verticalSwiping: true,
    arrows: false,
    speed: 500,
    cssEase: 'ease',
    fade: false,
    useTransform: false,
    lazyLoad: 'ondemand'
  }, slickOptions);

  if ($(window).width()! > breakpoint) {
    ($('.slider') as any).slick(opts);
  } else {
    $('.top80').css("padding-top", "0");
    $('#left').css("display", "none");
    $('#right').css("display", "none");
    $('#mobile').css("display", "flex");
    ($('.mslider') as any).slick(opts);
  }

  let blocked = false;
  let blockTimeout: ReturnType<typeof setTimeout> | null = null;
  let prevDeltaY = 0;

  document.body.addEventListener('wheel', function(e: WheelEvent) {
    const deltaY = e.deltaY;
    e.preventDefault();
    e.stopPropagation();

    if (blockTimeout) clearTimeout(blockTimeout);
    blockTimeout = setTimeout(function(){
      blocked = false;
    }, 100);

    if (deltaY > 0 && deltaY > prevDeltaY || deltaY < 0 && deltaY < prevDeltaY || !blocked) {
      blocked = true;
      prevDeltaY = deltaY;

      if (deltaY > 0) {
        safeSlick('#left .slider', 'slickNext');
        safeSlick('#right .slider', 'slickPrev');
        safeSlick('#mobile .mslider', 'slickNext');
      } else {
        safeSlick('#left .slider', 'slickPrev');
        safeSlick('#right .slider', 'slickNext');
        safeSlick('#mobile .mslider', 'slickPrev');
      }
    }
  }, { passive: false });

  if (includeJsActions) {
    $("#left img").on('click', function() {
      safeSlick('#left .slider', 'slickPrev');
      safeSlick('#right .slider', 'slickNext');
    });

    $("#right img").on('click', function() {
      safeSlick('#left .slider', 'slickNext');
      safeSlick('#right .slider', 'slickPrev');
    });

    $("#mobile img").on('click', function() {
      safeSlick('#mobile .mslider', 'slickNext');
    });

    $(document).on('keydown', function(e){
      if (e.which == 37) {
        safeSlick('#left .slider', 'slickPrev');
        safeSlick('#right .slider', 'slickNext');
        safeSlick('#mobile .mslider', 'slickPrev');
      }
      if (e.which == 39) {
        safeSlick('#left .slider', 'slickNext');
        safeSlick('#right .slider', 'slickPrev');
        safeSlick('#mobile .mslider', 'slickNext');
      }
      if (e.which == 38) {
        safeSlick('#left .slider', 'slickPrev');
        safeSlick('#right .slider', 'slickNext');
        safeSlick('#mobile .mslider', 'slickPrev');
      }
      if (e.which == 40) {
        safeSlick('#left .slider', 'slickNext');
        safeSlick('#right .slider', 'slickPrev');
        safeSlick('#mobile .mslider', 'slickNext');
      }
    });
  }
</script>
