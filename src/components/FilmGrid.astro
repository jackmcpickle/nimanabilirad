---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface FilmEntry {
  slug: string;
  title: string;
  thumbnail1: ImageMetadata;
  thumbnail2: ImageMetadata;
}

interface Props {
  films: FilmEntry[];
}

const { films } = Astro.props;
---

{films.map((film) => (
  <div class="w-full md:w-1/2 h37 video-titles">
    <a href={`/${film.slug}`}>
      <h4 class="newFilmTitles">{film.title}</h4>
      <div class="animate-img">
        <Image src={film.thumbnail1} alt={`${film.title} thumbnail`} />
        <Image src={film.thumbnail2} alt={`${film.title} alternate thumbnail`} />
      </div>
    </a>
  </div>
))}
