---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import BaseLayout from './BaseLayout.astro';
import FilmNav from '../components/FilmNav.astro';

interface Props {
  title: string;
  current: string;
}

const { title, current } = Astro.props;
---

<BaseLayout title={title}>
  <style is:global>
    .headspace {padding-top: 80px;margin: auto;}
  </style>

  <a class="logo-icon" href="/" transition:name="logo"><Image src={logo} alt="Nima Nabili Rad" /></a>

  <FilmNav current={current} />

  <slot />

  </div>

  <script>
    import hoverEffect from 'hover-effect';

    document.addEventListener('astro:page-load', () => {
      Array.from(document.querySelectorAll('.animate-img')).forEach(function(el) {
        if ((el as HTMLElement).dataset.hoverInitialized) return;
        const imgs = Array.from(el.querySelectorAll('img'));
        if (imgs.length < 2) return;
        new hoverEffect({
          parent: el,
          intensity: .8,
          speedIn: .6,
          speedOut: 1.6,
          hover: (el as HTMLElement).dataset.hover || undefined,
          image1: imgs[0].getAttribute('src'),
          image2: imgs[1].getAttribute('src'),
          displacementImage: '/img/dis2.jpg',
          imagesRatio: 350/800
        });
        (el as HTMLElement).dataset.hoverInitialized = 'true';
      });
    });
  </script>
</BaseLayout>
