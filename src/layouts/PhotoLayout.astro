---
import BaseLayout from './BaseLayout.astro';
import PhotoNav from '../components/PhotoNav.astro';

interface Props {
  title: string;
  current: string;
}

const { title, current } = Astro.props;
---

<BaseLayout title={title}>
  <PhotoNav current={current} />
  <div class="flex flex-wrap w-full no-padd top80">
    <slot />
  </div>
</BaseLayout>
